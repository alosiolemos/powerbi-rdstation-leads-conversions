// Expressão extraída do modelo; marca e referências específicas generalizadas.
HTML Título - Conversões Dinâmico =
VAR IconeSVG =
    "<svg width='25' height='25' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'>
        <circle cx='12' cy='12' r='9' fill='none' stroke='#DDFBEA' stroke-width='5'/>
        <circle cx='12' cy='12' r='9' fill='none' stroke='#16C75B' stroke-width='5'
            stroke-dasharray='20 56.5' stroke-linecap='round'
            transform='rotate(-90 12 12)'/>
        <circle cx='12' cy='12' r='9' fill='none' stroke='#50F296' stroke-width='5'
            stroke-dasharray='11 56.5' stroke-linecap='round'
            transform='rotate(35 12 12)'/>
    </svg>"

VAR Titulo =
    [Título Dinâmico - Conversões]

VAR Subtitulo =
    [Subtítulo Dinâmico - Conversões]

RETURN

    "<div style='
        width:100%;
        height:100%;
        max-height:100%;
        box-sizing:border-box;
        display:flex;
        align-items:center;
        gap:8px;
        font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica Neue,Arial,sans-serif;
        background:transparent;
        padding:0;
        margin:0;
        overflow:hidden;
    '>"

    & "<div style='
        width:30px;
        min-width:30px;
        height:30px;
        min-height:30px;
        display:flex;
        align-items:center;
        justify-content:center;
        line-height:0;
        padding:0;
        margin:0;
        overflow:hidden;
        flex-shrink:0;
    '>"
        & IconeSVG
    & "</div>"

    & "<div style='
        display:flex;
        flex-direction:column;
        justify-content:center;
        min-width:0;
        height:auto;
        padding:0;
        margin:0;
        overflow:hidden;
    '>"

        & "<div style='
            font-size:18px;
            font-weight:700;
            color:#252424;
            line-height:1;
            white-space:nowrap;
            padding:0;
            margin:0;
        '>"
            & Titulo
        & "</div>"

        & "<div style='
            margin:2px 0 0 0;
            padding:0;
            font-size:11px;
            font-weight:400;
            color:#7A8394;
            line-height:1;
            white-space:nowrap;
        '>"
            & Subtitulo
        & "</div>"

    & "</div>"

    & "</div>"
