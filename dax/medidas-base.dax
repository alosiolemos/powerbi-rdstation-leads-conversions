Quantidade de Contatos =
DISTINCTCOUNT(RD_Contatos[uuid])+0

Quantidade de Contatos levantada de mão =
CALCULATE(
    DISTINCTCOUNT(RD_Eventos_Contato[contact_uuid]),
    KEEPFILTERS(
        RD_Eventos_Contato[classificacao_evento] = "Levantada de Mão"
    )
) + 0

Quantidade de Contatos Levantada de Mão Legado =
CALCULATE(
    DISTINCTCOUNT(RD_Eventos_Contato[contact_uuid]),
    KEEPFILTERS(
        RD_Eventos_Contato[classificacao_evento] = "Levantada de Mão Legado"
    )
) + 0

